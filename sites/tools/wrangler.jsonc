{
  "name": "agentic-tools",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "tools.agiscorecard.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
