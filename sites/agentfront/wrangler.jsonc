// AgentFront — agentic-commerce landing + waitlist API (merged from the
// createjob session's matrix; see docs/competitive-analysis.md).
{
  "name": "agentfront",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "agentfront.agiscorecard.com", "custom_domain": true }
  ],
  "kv_namespaces": [
    { "binding": "SUBSCRIBERS", "id": "e981ec645ff54685a8139b0c26f6de82" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
