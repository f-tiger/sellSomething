{
  "name": "x402",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    { "pattern": "x402.agiscorecard.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Payment config (see README.md). PAYTO_ADDRESS is the owner's self-custody
  // EVM wallet (public info — same key controls it on Base). FACILITATOR_URL:
  // the x402.org default is TESTNET-ONLY, so we use PayAI's account-free
  // mainnet facilitator; switch to CDP later if desired.
  "vars": {
    "PAYTO_ADDRESS": "0x21d148385855B06114e83b25276070a399F882F9",
    "FACILITATOR_URL": "https://facilitator.payai.network"
  }
}
