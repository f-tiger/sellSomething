{
  "comments": {},
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["*", "*"],
    ["`", "`"]
  ],
  "wordPattern": "[^\\s\\[\\]\\(\\)]+",
  "folding": {
    "markers": {
      "start": "^##\\s",
      "end": "^##\\s"
    }
  }
}
